# Copie para .env e ajuste. NUNCA versione o .env real, e nunca mande por
# e-mail ou WhatsApp: ele contem as chaves do sistema.
#
# No servidor, quem cria este arquivo e' o deploy\instalar-no-servidor.ps1 —
# ele gera as duas chaves e preenche rede e caminhos. Este exemplo serve para
# consulta e para desenvolvimento.

# ------------------------------------------------------------------ chaves
# Chave do Django. Uma por ambiente. Trocar invalida todas as sessoes abertas.
SECRET_KEY=troque-esta-chave

# Cifragem das senhas de maquina (notebook e AnyDesk).
# Gere com:  manage.py gerar_chave_campos
# PERDER ESTA CHAVE = PERDER AS SENHAS. Ela viaja JUNTO com o banco: levar o
# db.sqlite3 para outra maquina sem levar esta linha torna as senhas
# ilegiveis para sempre. Guarde uma copia FORA dos backups do banco.
CAMPO_CRIPTO_KEY=

# ------------------------------------------------------------------ ambiente
# False em qualquer maquina que outra pessoa acesse.
DEBUG=True

# ------------------------------------------- rede (settings.servidor)
# Enderecos pelos quais o sistema pode ser chamado, separados por virgula.
# Obrigatorio no servidor: sem isto o Django recusa tudo com "Bad Request".
# Inclua o IP interno, o nome da maquina e — se expuser — o IP publico.
ITAM_HOSTS=localhost,127.0.0.1
ITAM_PORTA=8000

# HTTPS: True SO quando existir certificado de verdade na frente (Cloudflare,
# Caddy, IIS). Ligar sem isso TRAVA o login — redireciona para um https que
# nao existe e o cookie de sessao nao viaja em http.
ITAM_HTTPS=False
# True apenas se houver proxy reverso na frente. Ligado sem proxy, qualquer um
# poderia falsificar o IP no log de acesso e escapar do bloqueio por tentativas.
ITAM_ATRAS_DE_PROXY=False

# ---------------------------------------------- banco e anexos
# NUNCA em pasta sincronizada (OneDrive/Dropbox): o arquivo corrompe.
# DB_PATH=C:\dados/db.sqlite3
# MEDIA_ROOT=C:\midia
# Producao em VPS com PostgreSQL:
# DATABASE_URL=postgres://usuario:senha@localhost:5432/itam

# ---------------------------------------------- e-mail (recuperacao de senha)
# Sem isto, e-mail nao sai: a mensagem vai para o log e ninguem recebe.
# EMAIL_HOST=email-ssl.com.br
# EMAIL_PORT=465
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_SSL=True
# EMAIL_USE_TLS=False
# DEFAULT_FROM_EMAIL=ITAM Make Distribuidora <pessoa@exemplo.com.br>

# ---------------------------------------------- telemetria dos agentes
# Vazio = recurso desligado (o score volta a ser estimativa).
# TELEMETRIA_TOKEN=

# ---------------------------------------------- log
# LOG_LEVEL=INFO
# LOG_TO_FILE=True
